{
    "rewrites": [
        {
            "source": "/sitemap.xml",
            "destination": "https://api-promptdeck.vercel.app/sitemap.xml"
        },
        {
            "source": "/api/:path*",
            "destination": "https://api-promptdeck.vercel.app/api/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}